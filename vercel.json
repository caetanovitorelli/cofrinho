{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!professor).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://cruzeirodosulhub.vercel.app" }
      ]
    },
    {
      "source": "/professor",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
